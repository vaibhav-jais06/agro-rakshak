# ==============================================================================
# AGRO-RAKSHAK ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env for local development, or add these variables in your
# Vercel Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (React Client - built at build-time)
# Note: In Create React App, client variables MUST start with REACT_APP_
# ------------------------------------------------------------------------------

# Backend API URL (Optional on Vercel - leave empty to use Vercel Serverless /api)
# Set this ONLY if your backend is deployed on a separate domain (e.g. Render/Railway)
REACT_APP_API_BASE=

# Gemini API Key for client-side AI analysis
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# Public VAPID Key for browser Web Push notifications
REACT_APP_VAPID_PUBLIC_KEY=BClxUBNzz6-e-wJfrSnuG6r2KvhQdgOj42wSTsCmwSNit4F0ZmK0DPHYuvfHPYWG0vWskta_Y5OgLMf8aGLnkW8


# ------------------------------------------------------------------------------
# 2. BACKEND / SERVERLESS API ENVIRONMENT VARIABLES
# Add these in Vercel Project Settings -> Environment Variables
# ------------------------------------------------------------------------------

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/agro-rakshak?retryWrites=true&w=majority

# JWT Secret for user authentication tokens
JWT_SECRET=your_super_secret_jwt_key_agro_rakshak_2025

# Groq API Key (Used for Voice Assistant and fast AI inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Used for crop diagnosis & agricultural advice)
GEMINI_API_KEY=your_gemini_api_key_here

# Web Push Notification VAPID Credentials
VAPID_PUBLIC_KEY=BClxUBNzz6-e-wJfrSnuG6r2KvhQdgOj42wSTsCmwSNit4F0ZmK0DPHYuvfHPYWG0vWskta_Y5OgLMf8aGLnkW8
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=admin@agrorakshak.com

# Server Environment & Port (Local development)
NODE_ENV=production
PORT=5000
